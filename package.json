{
  "name": "mds",
  "type": "module",
  "scripts": {
    "dev": "pnpm web:dev",
    "build": "pnpm web:build",
    "start": "pnpm web:start",
    "preview": "pnpm web:preview",
    "test": "pnpm test:run",
    "check": "pnpm test:run && pnpm web:build && pnpm web:smoke",
    "web:dev": "vite dev",
    "web:build": "vite build",
    "web:start": "node scripts/start-web.mjs",
    "web:prod": "pnpm web:build && pnpm web:start",
    "web:preview": "vite preview",
    "web:smoke": "node scripts/smoke-web.mjs",
    "web:smoke:hydration": "node scripts/smoke-hydration.mjs",
    "test:run": "node scripts/run-vitest.mjs run",
    "test:watch": "node scripts/run-vitest.mjs",
    "get:explain": "node scripts/get-explain.mjs",
    "get:tts": "node scripts/get-tts.mjs",
    "get:cloze": "node scripts/get-cloze.mjs",
    "client:start": "electron .",
    "client:dev": "pnpm web:build && pnpm client:start",
    "client:package:dir": "pnpm web:build && electron-builder --win dir",
    "client:package": "node scripts/package-client.mjs",
    "client:package:wsl": "node scripts/package-client-wsl.mjs",
    "client:verify": "node scripts/verify-electron-package.mjs",
    "electron:start": "pnpm client:start",
    "electron:build": "pnpm client:package",
    "build:banks": "node scripts/build-banks.mjs",
    "build:pet-words": "node scripts/fetch-pet-words.mjs"
  },
  "dependencies": {
    "@solidjs/router": "^1.0.0",
    "@solidjs/start": "^2.0.0-rc.6",
    "es-toolkit": "^1.50.0",
    "h3": "2.0.1-rc.22",
    "lucide-solid": "^1.28.0",
    "nitro": "^3.0.260610-beta",
    "solid-js": "^1.9.14",
    "ts-fsrs": "^5.4.2",
    "vite": "^8.0.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.7",
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.2",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.62.1",
    "tailwindcss": "^4.0.7",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24"
  },
  "knip": {
    "entry": [
      "src/entry-client.tsx",
      "src/entry-server.tsx",
      "src/routes/**/*.{ts,tsx}",
      "src/lib/**/*.test.ts"
    ],
    "project": [
      "src/**"
    ]
  },
  "main": "electron/main.mjs",
  "build": {
    "appId": "com.neblor.mds",
    "productName": "mds",
    "directories": {
      "output": "dist/electron-test"
    },
    "beforeBuild": "./scripts/electron-builder-hooks.mjs",
    "files": [
      ".output/**",
      "!.output/public/word-cache/**",
      "electron/**",
      "package.json"
    ],
    "asar": false,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icons/app.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "mds-${version}-setup.exe",
      "shortcutName": "默点啥",
      "uninstallDisplayName": "默点啥",
      "language": "2052"
    },
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    }
  },
  "version": "0.8.1",
  "description": "默点啥 — 记单词 · 听写 · 默写小帮手",
  "author": "neblor"
}
